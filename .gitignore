# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env*.local

# plaintext dev credentials - never commit
/CREDENTIALS.md

# vercel
.vercel

# typescript
*.tsbuildinfo

# idea files
.idea
dist/

# Locally built APKs, kept out of the repository
HATUD-v*.apk

# Local data backups (may hold password hashes)
.backups/
